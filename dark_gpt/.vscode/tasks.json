{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DARK-GPT // Terminal",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/dark_gpt.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "DARK-GPT // Maximize Terminal",
      "command": "${command:workbench.action.toggleMaximizedPanel}",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
