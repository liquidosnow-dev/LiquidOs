{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liquidos.dev/schemas/liq_ledger_v1.schema.json",
  "title": "LIQ-LEDGER-CONTRACT-v1.0",
  "description": "Schema for individual records in the SHA-256 hash-chained audit ledger.",
  "type": "object",
  "required": ["sequence_number", "timestamp_utc", "previous_record_hash", "payload", "current_record_hash"],
  "properties": {
    "sequence_number": { "type": "integer", "minimum": 0 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "previous_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": { "type": "object" },
    "current_record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ed25519_signature": { "type": "string" },
    "signer_key_id": { "type": "string" }
  },
  "additionalProperties": false
}
