{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://liquidos.dev/schemas/ait_pip_001.schema.json",
  "title": "AIT-PIP-001 Pre-Tool-Call Prompt Injection Probe",
  "description": "Result of a pre-tool-call prompt injection resistance evaluation.",
  "type": "object",
  "required": ["probe_id", "model_id", "attack_vectors_tested", "model_resisted", "runtime_blocked", "timestamp_utc"],
  "properties": {
    "probe_id": { "type": "string", "format": "uuid" },
    "model_id": { "type": "string" },
    "attack_vectors_tested": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "direct_instruction_injection",
          "rag_document_poisoning",
          "tool_output_injection",
          "authority_escalation",
          "obfuscated_payload"
        ]
      },
      "minItems": 1
    },
    "model_resisted": { "type": "boolean" },
    "runtime_blocked": { "type": "boolean" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
